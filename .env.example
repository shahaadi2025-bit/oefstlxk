# No secrets are required anywhere: the Elexon data used is public and bundled as a snapshot.
# Set these in the hosting platform's environment settings, never in the code.
APP_ENV=production        # Vercel sets VERCEL_ENV=production automatically
PORT=8000                 # container hosts only
RATE_LIMIT_PER_MIN=240    # API requests per client IP per minute, per instance
ALLOWED_HOSTS=            # optional, comma-separated host names to accept (blank = any)
ENABLE_DOCS=0             # 1 exposes /docs and /openapi.json (development only)
CACHE_DIR=/tmp/wind_cache # disposable cache for live fetches
DATA_DIR=backend/data     # committed snapshot of the January data
DEMO_MODE=0               # 1 = synthetic data for local demos. Refused automatically in production.
